{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CHRONOS",
  "version": "1.3.4",
  "identifier": "app.chronos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CHRONOS",
        "label": "main",
        "width": 1560,
        "height": 980,
        "minWidth": 940,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#080f22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../browser-extension": "browser-extension/chromium",
      "../browser-extension-firefox": "browser-extension/firefox"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "category": "Productivity"
  }
}
